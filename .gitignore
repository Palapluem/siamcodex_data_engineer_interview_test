# Lab credentials and CA - never commit (bootstrap.py generates these locally)
candidate/.runtime/
.runtime/

# Local env / secrets
.env
*.env
!*.env.example
candidate/submission/.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Evidence artifacts that are regenerated (keep the committed report, not raw dumps)
evidence/raw/
*.log

# Build output (regenerate with tools/make_submission_zip.py)
dist/

# Private working documents - kept locally, never published.
# A directory rather than a list: a new private note is covered by default,
# instead of relying on someone remembering to add it.
private/
